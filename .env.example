# 값은 넣지 않는다. 키 이름만 유지한다.

# 기본 생성 모델 — Google AI Studio 무료 쿼터로 Gemma 4 31B 호출 (docs/DECISIONS.md D-01)
GOOGLE_API_KEY=

# 평가 질의(summary_q)를 LLM에 넣는 평가·실험에만 사용 — OpenRouter (docs/SPEC.md 자원 제약)
OPENROUTER_API_KEY=

# HF Spaces 배포, 모델 가중치 다운로드
HUGGINGFACEHUB_API_TOKEN=

# 임베딩 배치를 Colab 대신 RunPod에서 돌릴 때만 필요
RUNPOD_API_KEY=

# 생성 체인 트레이싱. LANGCHAIN_* 는 구 이름이고 아직 인식된다
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=meet-rag

# 생성 모델을 vLLM(OpenAI 호환 서버)으로 직접 띄울 때. Colab 세션마다 주소가 바뀐다
VLLM_BASE_URL=
VLLM_API_KEY=

# HF 모델 캐시 위치. 절대경로로 적는다. 노트북 커널은 notebooks/에서 실행되고 VS Code가 .env를 커널에 넘기므로
# 상대경로면 notebooks/.hf_cache로 어긋난다 (rag.index는 상대경로를 저장소 루트 기준으로 바꾼다)
HF_HOME=C:/path/to/meet-rag/.hf_cache

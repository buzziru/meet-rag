# 값은 넣지 않는다. 키 이름만 유지한다. (PROJECT.md §10)

# 기본 생성 모델 — Google AI Studio 무료 쿼터로 Gemma 4 31B 호출 (docs/DECISIONS.md D-01)
GOOGLE_API_KEY=

# 대량 배치 평가 시에만 사용 — OpenRouter
OPENROUTER_API_KEY=

# HF Spaces 배포, 모델 가중치 다운로드
HUGGINGFACEHUB_API_TOKEN=

# 임베딩 배치를 RunPod에서 돌릴 때만 필요
RUNPOD_API_KEY=

# 생성 체인 트레이싱 (ADR 0007). LANGCHAIN_* 는 구 이름이고 아직 인식된다
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mit-rag

# 소형 3종 비교용 vLLM 서버 (ADR 0008). Colab/RunPod 세션마다 주소가 바뀐다
VLLM_BASE_URL=
VLLM_API_KEY=

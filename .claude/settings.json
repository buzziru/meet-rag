{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__ccd_turn__wrap_up",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/wrap_up_report_guard.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__ccd_turn__wrap_up",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/wrap_up_reminder.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
